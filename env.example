# Hoopster configuration template (task 2026-10-17_dev_environment; contract in config/README.md).
# Named env.example (no leading dot) because .env* files are protected from agent tools.
#
# Copy to .env for local development:   Copy-Item env.example .env
# .env is git-excluded. It holds NON-SECRET settings only.
#
# The four SECRET variables below are documented here but must NOT be put in .env on the
# Overseer's PC (the project folder is OneDrive-synced). Set them as Windows user environment
# variables instead; delete these four lines from your .env. On Render, set the first ten as the
# service's environment variables (Render supplies PORT itself; there is no .env there).

# --- Secrets: Windows user environment variables, never in .env ---------------------------
# SQLAlchemy URL for the application role (write access). Percent-encode reserved characters
# in the password. Neon: append ?sslmode=require
DATABASE_URL=postgresql+psycopg://hoopster_app:CHANGE_ME@localhost:5432/hoopster_db
# Signs the Flask session and the remember-me cookie. 64 hex chars: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
# Signs the device-key cookie (REQ-069). 64 hex chars, different from SECRET_KEY.
DEVICE_KEY_SECRET=CHANGE_ME
# Secret path of the no-database health page the uptime pinger calls (REQ-046). Must start with /.
# python -c "import secrets; print('/health-' + secrets.token_urlsafe(24))"
HEALTH_PATH=/health-CHANGE_ME

# --- Non-secret settings: these belong in .env ---------------------------------------------
# development or production (drives debug/hot-reload and secure-cookie flags)
APP_ENV=development
# Login lockout (REQ-070): failures within the window lock the device + email pair for the lock duration
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# true logs every request's and database call's duration (REQ-068)
LOG_TIMINGS=false
# Local development server port (Render sets its own)
PORT=8050
